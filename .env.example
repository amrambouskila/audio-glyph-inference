# audio-glyph-inference — environment defaults (committed; copy to .env to override locally).
# Real secrets, if ever needed, go in .env.local (gitignored). See CLAUDE.md §6.
# docker-compose auto-loads .env; config.BackendSettings reads BACKEND_* from the process env.

# --- Postgres (docker-compose `postgres` service) ---
POSTGRES_DB=audio_glyph_inference
POSTGRES_USER=agi_dev
POSTGRES_PASSWORD=agi_dev_password
POSTGRES_PORT=5520

# --- Redis (docker-compose `redis` service) ---
REDIS_PORT=6520

# --- Backend (FastAPI) ---
BACKEND_PORT=8220
BACKEND_LOG_LEVEL=info
# Inside the compose network the backend reaches services by name. For host-local
# runs (no Docker), point these at wherever Postgres/Redis actually live:
BACKEND_DATABASE_URL=postgresql+asyncpg://agi_dev:agi_dev_password@postgres:5432/audio_glyph_inference
BACKEND_REDIS_URL=redis://redis:6379/0

# --- Audio ingest validation + normalization (defaults from recording_protocol.md §3; uncomment to override) ---
# BACKEND_AUDIO_DURATION_MIN_S=1.0
# BACKEND_AUDIO_DURATION_MAX_S=3.0
# BACKEND_AUDIO_ACTIVE_SPEECH_MIN_S=0.4
# BACKEND_AUDIO_ACTIVE_SPEECH_MAX_S=1.5
# BACKEND_AUDIO_SILENCE_PAD_MAX_S=0.3
# BACKEND_AUDIO_PEAK_DBFS_MAX=-1.0
# BACKEND_AUDIO_TARGET_LUFS=-23.0
# BACKEND_AUDIO_VAD_TOP_DB=30.0
# BACKEND_AUDIO_DEFAULT_SPEAKER_ID=owner
# BACKEND_AUDIO_MAX_UPLOAD_BYTES=10485760

# --- Phase-2 audio→feature extraction (uncomment to override) ---
# BACKEND_FEATURE_N_MELS=8
# BACKEND_FEATURE_N_SEGMENTS=3

# --- Phase-2 MDL complexity weights (calibrated at kickoff; uncomment to override) ---
# BACKEND_COMPLEXITY_BITS_PER_PARAM=1.0
# BACKEND_COMPLEXITY_ORDER_PENALTY=1.0
# BACKEND_COMPLEXITY_STRUCT_COST=1.0

# --- Phase-2 search knobs (calibrated at kickoff; uncomment to override) ---
# BACKEND_SEARCH_GRID_RESOLUTION=5
# BACKEND_SEARCH_GRID_TRUNCATION=error
# BACKEND_SEARCH_LOG_SCALE_KEYS='["ridge_alpha"]'
# BACKEND_FOURIER_K_MAX=3
# BACKEND_CMA_SIGMA0=0.25
# BACKEND_CMA_TOLFUN=1e-11
# BACKEND_BAYESIAN_INITIAL_POINTS=5
# BACKEND_BAYESIAN_CANDIDATE_POOL_SIZE=128
# BACKEND_BAYESIAN_LENGTH_SCALE=0.25
# BACKEND_BAYESIAN_NOISE=1e-9
# BACKEND_SEARCH_DEFAULT_LAMBDA=0.01
# BACKEND_SEARCH_PER_LETTER_PENALTY=1.0
# BACKEND_SIMPLICITY_C_SCALE=50.0
# BACKEND_INTERPRETABILITY_PRIOR_FOURIER=0.8
# BACKEND_INTERPRETABILITY_PRIOR_LISSAJOUS=1.0
# BACKEND_INTERPRETABILITY_PRIOR_PHASE_SPACE=0.9
# BACKEND_INTERPRETABILITY_PRIOR_SYMBOLIC=0.7
# BACKEND_SEARCH_MULTISTROKE_METRIC=chamfer

# --- Phase-3 symbolic-regression knobs (requires backend[symbolic]; uncomment to override) ---
# BACKEND_SYMBOLIC_FOURIER_K=2
# BACKEND_SYMBOLIC_NITERATIONS=20
# BACKEND_SYMBOLIC_MAXSIZE=20
# BACKEND_SYMBOLIC_BINARY_OPERATORS='["+","-","*","/"]'
# BACKEND_SYMBOLIC_UNARY_OPERATORS='["sin","cos","tanh"]'
# BACKEND_SYMBOLIC_MODEL_SELECTION=best

# --- Phase 4 frontend ---
VITE_PORT=5220
VITE_API_BASE_URL=http://localhost:8220
VITE_WS_URL=ws://localhost:8220/ws/live
VITE_AUDIO_SAMPLE_RATE_HZ=16000
